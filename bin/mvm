#!/usr/bin/env nu

const mvm_directory = ".mvm"
const config_label = "mvm-config"
const setup_marker = "/var/lib/mvm/setup-done"
const scoped_flags = {
    resources: "--resource-conf"
    runtime: "--runtime-conf"
    fs: "--fs-conf"
    network: "--net-conf"
    secrets: "--secret-conf"
    scripts: "--script-conf"
}

def config-files []: nothing -> table {
    if ($mvm_directory | path type) != "dir" {
        error make {msg: $"No ($mvm_directory) directory in ($env.PWD)."}
    }

    let files = (
        ls $mvm_directory
        | where type == file and name =~ '\.ya?ml$'
        | sort-by name
        | each {|file| {path: $file.name, stem: ($file.name | path parse | get stem)} }
    )
    if ($files | is-empty) {
        error make {msg: $"No .yaml or .yml config files in ($mvm_directory)."}
    }

    let duplicates = ($files | group-by stem | values | where ($it | length) > 1)
    if not ($duplicates | is-empty) {
        let paths = ($duplicates | first | get path | str join " and ")
        error make {msg: $"($paths) configure the same file name; keep one."}
    }

    $files
}

def config-arguments [files: table]: nothing -> list<string> {
    let sandbox = ($files | where stem == "sandbox")
    let scoped = ($files | where stem in ($scoped_flags | columns))
    let root = ($files | where stem != "sandbox" and stem not-in ($scoped_flags | columns))

    [
        ...($sandbox | each {|file| [--conf $file.path] } | flatten)
        ...($root | each {|file| [--conf $file.path] } | flatten)
        ...($scoped | each {|file| [($scoped_flags | get $file.stem) $file.path] } | flatten)
    ]
}

def config-hash [files: table]: nothing -> string {
    $files
    | each {|file| $"(open --raw $file.path | hash sha256)  ($file.path)" }
    | str join (char newline)
    | hash sha256
    | str substring 0..<16
}

def sanitize-name [name: string]: nothing -> string {
    $name
    | str lowercase
    | str replace --all --regex '[^a-z0-9-]+' '-'
    | str trim --char '-'
    | str substring 0..<128
}

def shell-quote [argument: string]: nothing -> string {
    if $argument =~ '^[A-Za-z0-9_./=:@%+,-]+$' {
        $argument
    } else {
        $"'($argument | str replace --all "'" "'\\''")'"
    }
}

def script-names [files: table]: nothing -> list<string> {
    $files
    | each {|file|
        let data = try { open $file.path } catch { null }
        if not ($data | describe | str starts-with "record") {
            []
        } else if $file.stem == "scripts" {
            $data | columns
        } else {
            $data | get -o scripts | default {} | columns
        }
    }
    | flatten
    | uniq
}

def provision-command [scripts: list<string>, booted: bool]: nothing -> string {
    let setup = ($scripts | where {|name| $name == "setup" or ($name | str starts-with "setup-") } | sort)
    let start = if $booted {
        $scripts | where {|name| $name | str starts-with "start-" } | sort
    } else {
        []
    }
    let run = {|name| $"echo (shell-quote $'mvm: running ($name)'); /.msb/scripts/(shell-quote $name)" }

    [
        ...(if ($setup | is-empty) { [] } else {
            [
                $"if [ ! -e ($setup_marker) ]; then"
                ...($setup | each $run)
                $"mkdir -p ($setup_marker | path dirname) && touch ($setup_marker)"
                "fi"
            ]
        })
        ...($start | each $run)
    ]
    | if ($in | is-empty) { "" } else { ["set -e" ...$in] | str join (char newline) }
}

def provision [name: string, command: string] {
    if ($command | is-empty) {
        return
    }
    try {
        ^msb exec $name -- sh -c $command
    } catch {
        error make {msg: $"Provisioning sandbox ($name) failed; run mvm again to retry, or mvm --replace after fixing the ($mvm_directory) scripts."}
    }
}

def check-kvm-access [] {
    if $nu.os-info.name != "linux" {
        return
    }

    if not ("/dev/kvm" | path exists) {
        error make {msg: "/dev/kvm is missing; microsandbox requires KVM on Linux."}
    }
    if (^test -r /dev/kvm -a -w /dev/kvm | complete).exit_code != 0 {
        let group = (ls -l /dev/kvm | first | get group)
        error make {msg: $"No read/write access to /dev/kvm; add (^id -un) to the ($group) group and log in again."}
    }
}

def sandbox-listed [name: string, filters: list<string> = []]: nothing -> bool {
    let result = (^msb list --quiet ...$filters | complete)
    if $result.exit_code != 0 {
        error make {msg: $"msb list failed: ($result.stderr | str trim)"}
    }

    $name in ($result.stdout | lines)
}

# Start a microsandbox VM from the YAML config files in ./.mvm.
#
# The current directory is mounted to /workspace inside the VM.
#
# Config files (.yaml or .yml) map to msb create flags by file name:
#   sandbox      --conf
#   resources    --resource-conf
#   runtime      --runtime-conf
#   fs           --fs-conf
#   network      --net-conf
#   secrets      --secret-conf
#   scripts      --script-conf
# Any other YAML file is passed with --conf after sandbox.yaml, in name order.
# Scoped files load after root files, so their values take precedence.
# Relative paths inside a config file resolve against .mvm, not the current path.
#
# An existing sandbox with the same name is started instead of recreated.
# msb create and msb start return once the VM boots; the VM keeps running in the background.
#
# Scripts named setup and setup-* run once, in name order, after the sandbox is created;
# a failed setup runs again on the next mvm. Scripts named start-* run, in name order,
# each time mvm boots the sandbox. `initdev mvm` adds these scripts for selected features.
#
# Arguments after -- are passed to msb create.
#
# Use --shell to open an interactive shell inside the VM at /workspace.
def main [
    --name (-n): string # Sandbox name (default: current directory name)
    --replace # Recreate the sandbox from the current config files
    --shell (-s) # Open an interactive shell at /workspace after starting
    --dry-run # Print the msb commands without running them
    ...create_args: string # Arguments passed to msb create after --
] {
    let files = (config-files)

    let name = if $name == null {
        let derived = (sanitize-name ($env.PWD | path basename))
        if ($derived | is-empty) {
            error make {msg: $"Cannot derive a sandbox name from ($env.PWD); pass --name."}
        }
        $derived
    } else {
        $name
    }

    let hash = (config-hash $files)
    let create_command = [
        msb create
        --name $name
        --label $"($config_label)=($hash)"
        --volume $"($env.PWD):/workspace"
        ...(if $replace { [--replace] } else { [] })
        ...(config-arguments $files)
        ...$create_args
    ]

    let scripts = (script-names $files)

    if $dry_run {
        print ($create_command | each {|argument| shell-quote $argument } | str join " ")
        let command = (provision-command $scripts true)
        if not ($command | is-empty) {
            print $"msb exec ($name) -- sh -c (shell-quote $command)"
        }
        if $shell {
            print $"msb exec ($name) --workdir /workspace -- sh -l"
        }
        return
    }

    if (which msb | is-empty) {
        error make {msg: "msb is not installed."}
    }
    check-kvm-access

    let booted = if (not $replace) and (sandbox-listed $name) {
        if not ($create_args | is-empty) {
            print -e $"mvm: ignoring msb create arguments because sandbox ($name) already exists; use --replace to apply them."
        }
        if not (sandbox-listed $name [--label $"($config_label)=($hash)"]) {
            print -e $"mvm: ($mvm_directory) config files changed since sandbox ($name) was created; run mvm --replace to recreate it."
        }
        if (sandbox-listed $name [--running]) {
            false
        } else {
            ^msb start $name
            true
        }
    } else {
        run-external ...$create_command
        true
    }

    provision $name (provision-command $scripts $booted)

    if $shell {
        exec msb exec $name --workdir /workspace -- sh -l
    }
    if not $booted {
        print $"Sandbox ($name) is already running."
    }
}
